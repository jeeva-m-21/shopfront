# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopfront

# Base Application URL (used for CSRF Origin verification)
APP_BASE_URL=http://localhost:3000

# Runtime & Visibility
NODE_ENV=development
SHOW_SAMPLE_DATA=false

# Stage 2 Reranker (Jev Decisions API)
RERANK_ENABLED=false
JEV_API_BASE_URL=https://api.typesafe.ai/v1/decisions
JEV_API_KEY=
JEV_MODEL=jev-1.13-20260917

# Budgets & Thresholds (ms and counts)
JEV_TIMEOUT_MS=450
TOTAL_BUDGET_MS=700
STAGE1_TIMEOUT_MS=250
ITEM_MATCH_THRESHOLD=0.15
CANDIDATE_POOL_SIZE=200
CANDIDATE_COUNT=10

# Rate Limiting & Operations
PUBLIC_RATE_LIMIT_PER_MIN=60
TRUST_PROXY=false
LOG_RETENTION_DAYS=90
